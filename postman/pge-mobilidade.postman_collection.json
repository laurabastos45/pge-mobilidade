{
  "info": {
    "name": "PGE Mobilidade - API",
    "description": "Fluxo completo de uma corrida pelo API Gateway (porta 8080). Rode as pastas em ordem: 1 (fluxo feliz) e depois 2 (erros esperados). O id da corrida criada é salvo sozinho na variável rideId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clientId", "value": "1" },
    { "key": "driverId", "value": "2" },
    { "key": "rideId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Fluxo feliz",
      "item": [
        {
          "name": "1.1 Estimar rota",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rides/estimate?originLat=-3.7319&originLng=-38.5267&destinationLat=-3.7900&destinationLng=-38.5200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rides", "estimate"],
              "query": [
                { "key": "originLat", "value": "-3.7319" },
                { "key": "originLng", "value": "-38.5267" },
                { "key": "destinationLat", "value": "-3.7900" },
                { "key": "destinationLng", "value": "-38.5200" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('tem preço estimado', () => pm.expect(pm.response.json().estimatedPrice).to.be.above(0));"
          ] } }]
        },
        {
          "name": "1.2 Solicitar corrida (cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": {{clientId}},\n  \"origin\": \"Praça do Ferreira, Fortaleza\",\n  \"destination\": \"Shopping Iguatemi, Fortaleza\",\n  \"originLat\": -3.7319,\n  \"originLng\": -38.5267,\n  \"destinationLat\": -3.7900,\n  \"destinationLng\": -38.5200\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const ride = pm.response.json();",
            "pm.test('status WAITING', () => pm.expect(ride.status).to.eql('WAITING'));",
            "pm.collectionVariables.set('rideId', ride.id);"
          ] } }]
        },
        {
          "name": "1.3 Corridas disponíveis (motorista)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/rides/available", "host": ["{{baseUrl}}"], "path": ["api", "rides", "available"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const id = Number(pm.collectionVariables.get('rideId'));",
            "pm.test('a corrida criada está na lista', () => pm.expect(pm.response.json().map(r => r.id)).to.include(id));"
          ] } }]
        },
        {
          "name": "1.4 Aceitar corrida (motorista)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides/{{rideId}}/accept", "host": ["{{baseUrl}}"], "path": ["api", "rides", "{{rideId}}", "accept"] },
            "body": { "mode": "raw", "raw": "{\n  \"driverId\": {{driverId}}\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status ACCEPTED', () => pm.expect(pm.response.json().status).to.eql('ACCEPTED'));"
          ] } }]
        },
        {
          "name": "1.5 Iniciar corrida",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/rides/{{rideId}}/start", "host": ["{{baseUrl}}"], "path": ["api", "rides", "{{rideId}}", "start"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));"
          ] } }]
        },
        {
          "name": "1.6 Finalizar corrida",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/rides/{{rideId}}/complete", "host": ["{{baseUrl}}"], "path": ["api", "rides", "{{rideId}}", "complete"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
          ] } }]
        }
      ]
    },
    {
      "name": "2. Erros esperados",
      "item": [
        {
          "name": "2.1 Aceitar corrida já finalizada → 409",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides/{{rideId}}/accept", "host": ["{{baseUrl}}"], "path": ["api", "rides", "{{rideId}}", "accept"] },
            "body": { "mode": "raw", "raw": "{\n  \"driverId\": {{driverId}}\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }]
        },
        {
          "name": "2.2 Cliente inexistente → 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] },
            "body": { "mode": "raw", "raw": "{\n  \"clientId\": 999,\n  \"origin\": \"A\",\n  \"destination\": \"B\",\n  \"originLat\": -3.7319,\n  \"originLng\": -38.5267,\n  \"destinationLat\": -3.7900,\n  \"destinationLng\": -38.5200\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "2.3 Motorista tentando pedir corrida → 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] },
            "body": { "mode": "raw", "raw": "{\n  \"clientId\": {{driverId}},\n  \"origin\": \"A\",\n  \"destination\": \"B\",\n  \"originLat\": -3.7319,\n  \"originLng\": -38.5267,\n  \"destinationLat\": -3.7900,\n  \"destinationLng\": -38.5200\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ] } }]
        },
        {
          "name": "2.4 Origem igual ao destino → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] },
            "body": { "mode": "raw", "raw": "{\n  \"clientId\": {{clientId}},\n  \"origin\": \"Centro\",\n  \"destination\": \"Centro\",\n  \"originLat\": -3.7319,\n  \"originLng\": -38.5267,\n  \"destinationLat\": -3.7900,\n  \"destinationLng\": -38.5200\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }]
        }
      ]
    },
    {
      "name": "3. CORS (o bug do Solicitar corrida)",
      "item": [
        {
          "name": "3.1 Preflight do POST vindo do front",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:4200" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "content-type" }
            ],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('libera a origem do front', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:4200'));",
            "pm.test('libera o POST', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));"
          ] } }]
        },
        {
          "name": "3.2 Resposta com Origin: cabeçalho aparece uma vez só",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "http://localhost:4200" }],
            "url": { "raw": "{{baseUrl}}/api/rides/available", "host": ["{{baseUrl}}"], "path": ["api", "rides", "available"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const acao = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'access-control-allow-origin');",
            "pm.test('Access-Control-Allow-Origin aparece exatamente 1 vez', () => pm.expect(acao.length).to.eql(1));"
          ] } }]
        },
        {
          "name": "3.3 Origem não autorizada é recusada",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "https://site-qualquer.com" },
              { "key": "Access-Control-Request-Method", "value": "POST" }
            ],
            "url": { "raw": "{{baseUrl}}/api/rides", "host": ["{{baseUrl}}"], "path": ["api", "rides"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ] } }]
        }
      ]
    }
  ]
}
